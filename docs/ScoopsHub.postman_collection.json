{
  "info": {
    "_postman_id": "e58fa26b-12d4-4bb5-953b-e1b9f71c4c92",
    "name": "ScoopsHub API",
    "description": "Official Postman Collection for ScoopsHub REST API (Delivergate Backend Engineer Intern Practical Exam).\n\n### Overview\nScoopsHub is an ice cream parlour management API built with Laravel 13, MySQL, and Laravel Sanctum.\n\n### Getting Started\n1. Ensure the local server is running at `http://127.0.0.1:8000` (or update `base_url`).\n2. Open the **Authentication** folder and send **Login as Owner** (or Manager/Cashier).\n3. The test script automatically captures the returned token and stores it in the `bearer_token` collection variable.\n4. Subsequent requests in **Items** and **Customers** folders use `{{bearer_token}}` automatically.\n5. When testing role-restricted operations (e.g. DELETE requires Owner), switch your active user by running the corresponding Login request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Local API server base URL"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string",
      "description": "Sanctum bearer token populated automatically upon login"
    },
    {
      "key": "item_id",
      "value": "1",
      "type": "string",
      "description": "Item ID used for show, update, and delete tests. Populated by Create Item."
    },
    {
      "key": "customer_id",
      "value": "1",
      "type": "string",
      "description": "Customer ID used for show, update, and delete tests. Populated by Create Customer."
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Endpoints for Sanctum token-based authentication and user verification.",
      "item": [
        {
          "name": "1. Login as Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has Sanctum token and Bearer type\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token_type).to.eql(\"Bearer\");",
                  "    pm.expect(json.user.role).to.eql(\"owner\");",
                  "    pm.collectionVariables.set(\"bearer_token\", json.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@scoopshub.test\",\n  \"password\": \"Owner123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates as Owner. The test script saves the Sanctum bearer token to `{{bearer_token}}`."
          }
        },
